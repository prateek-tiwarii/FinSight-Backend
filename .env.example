# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Upload constraints
MAX_UPLOAD_SIZE_MB=10

# Runtime
ENVIRONMENT=development
FRONTEND_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_SQL=false
AUTH_REQUIRED=true

# Neon PostgreSQL
# Use the pooled connection string for the app and the direct string for migrations.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DIRECT_URL=postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# Sessions (opaque HttpOnly cookies; tokens are stored hashed)
AUTH_SESSION_DAYS=7
GUEST_SESSION_DAYS=7
GUEST_MAX_PORTFOLIOS=10
GUEST_MAX_ANALYSES=25
COOKIE_PREFIX=finsight
COOKIE_SAMESITE=lax
# Leave unset to auto-enable Secure in production.
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# Rate limiting (per client IP)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER=5
RATE_LIMIT_LOGIN=10
RATE_LIMIT_GUEST=20

# LangGraph checkpoints: auto|postgres|memory
CHECKPOINT_BACKEND=auto
# Defaults to DATABASE_URL when omitted.
# CHECKPOINT_DSN=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
